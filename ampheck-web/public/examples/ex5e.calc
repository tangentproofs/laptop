laws boolean

theorem ex5e: x = ¬x ≡ ⊥
    x = ¬x                         exclusion
=   x ⧧ x                          unequality
=   ¬(x = x)                       reflexive
=   ¬⊤                             binary law
=   ¬¬⊥                            double negation
=   ⊥
