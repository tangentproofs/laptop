# Calculations written as aPToP writes them, checked by `ampheck --check`
# and translated into Lean theorems by `ampheck_proofs` (Ampheck.Lean).

laws boolean

theorem portation demo: a ⇒ (b ⇒ a)
    a ⇒ (b ⇒ a)          portation
=   a ∧ b ⇒ a            specialization
=   ⊤

theorem deep duality: x ∧ ¬(y ∧ z) ≡ x ∧ (¬y ∨ ¬z)
    x ∧ ¬(y ∧ z)         duality
=   x ∧ (¬y ∨ ¬z)

theorem two laws: ¬¬(a ∨ a) ≡ a
    ¬¬(a ∨ a)            double negation, idempotent
=   a
