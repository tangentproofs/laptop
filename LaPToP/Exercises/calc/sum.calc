# Exercise 140, the implementation. It extends the specification, so it has the
# state n, s and the specification R, and it owes a refinement of R. The new
# specification Q it introduces is called by the refinement of R, so it owes a
# refinement of Q too; that one calls Q itself, which is the loop.
#
# n is natural, so the substitution law for n:= n–1 keeps n–1: nat — the
# assignment has no final state when n is 0 — and it is the if that makes
# that branch reachable only when n is not 0.

extends "sum.spec.calc"
laws boolean

spec Q = 2×s′ = 2×s + n×(n–1)

refine R ⟸ s:= 0. Q
    R ⟸ s:= 0. Q                              definition of Q
=   R ⟸ s:= 0. 2×s′ = 2×s + n×(n–1)          substitution law
=   R ⟸ 2×s′ = 2×0 + n×(n–1)                 arithmetic
=   R ⟸ 2×s′ = n×(n–1)                       definition of R
=   R ⟸ R                                     reflexive
=   ⊤

refine Q ⟸ if n = 0 then ok else n:= n–1. s:= s+n. Q fi
    Q ⟸ if n = 0 then ok else n:= n–1. s:= s+n. Q fi                              definition of Q
=   Q ⟸ if n = 0 then ok else n:= n–1. s:= s+n. 2×s′ = 2×s + n×(n–1) fi          substitution law
=   Q ⟸ if n = 0 then ok else n:= n–1. 2×s′ = 2×(s+n) + n×(n–1) fi               substitution law
=   Q ⟸ if n = 0 then ok else n–1: nat ∧ 2×s′ = 2×(s+(n–1)) + (n–1)×(n–1–1) fi             ok
=   Q ⟸ if n = 0 then n′ = n ∧ s′ = s else n–1: nat ∧ 2×s′ = 2×(s+(n–1)) + (n–1)×(n–1–1) fi    definition of Q
=   (2×s′ = 2×s + n×(n–1)) ⟸ if n = 0 then n′ = n ∧ s′ = s else n–1: nat ∧ 2×s′ = 2×(s+(n–1)) + (n–1)×(n–1–1) fi    arithmetic
=   ⊤
