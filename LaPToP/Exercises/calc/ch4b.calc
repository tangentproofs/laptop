# Exercises 136 and 137 of aPToP §10.4, written as calculations.

laws boolean

# ---------------------------------------------------------------------------
# Exercise 136 (a): in binary variables x and y, x:= x=y. x:= x=y is ok.

state x, y: bin

theorem ex136a: (x:= x=y. x:= x=y) ≡ ok
    x:= x=y. x:= x=y                       assignment
=   x:= x=y. x′ = (x = y) ∧ y′ = y         substitution law
=   x′ = ((x = y) = y) ∧ y′ = y            associative
=   x′ = (x = (y = y)) ∧ y′ = y            reflexive
=   x′ = (x = ⊤) ∧ y′ = y                  identity
=   x′ = x ∧ y′ = y                        ok
=   ok
