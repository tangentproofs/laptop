# aPToP Exercise 139 solution — natural loop refinement (exact solution).
# P = m:= m+n–9. n:= 10

laws boolean
state n, m: nat

spec P = m:= m+n–9. n:= 10

theorem ex139: (n:= n+1. if n=10 then ok else m:= m–1. P fi) ≡ P
    n:= n+1. if n=10 then ok else m:= m–1. P fi                         replace ok and P
=   n:= n+1. if n=10 then m′=m ∧ n′=n else m:= m–1. m:= m+n–9. n:= 10   replace final assignment
=   n:= n+1. if n=10 then m′=m ∧ n′=n else m:= m–1. m:= m+n–9. m′=m ∧ n′=10
=   n:= n+1. if n=10 then m′=m ∧ n′=n else m′=m–1+n–9 ∧ n′=10           two substitutions
=   if n+1=10 then m′=m ∧ n′=n+1 else m′=m–1+n+1–9 ∧ n′=10              substitution
=   if n=9 then m′=m ∧ n′=n+1 else m′=m+n–9 ∧ n′=10                     arithmetic
=   if n=9 then m′=m+n–9 ∧ n′=10 else m′=m+n–9 ∧ n′=10                  context
=   m′=m+n–9 ∧ n′=10                                                    case idempotent
=   m:= m+n–9. n:= 10                                                   definitions of assignment and sequential composition
=   P
