# Stub from LaPToP/Exercises/calc/ch4.calc (may not apply cleanly in Netty).
laws boolean

state x, y: int

theorem ex121i: (x:= 1. y:= 2. x:= x+y) ≡ x′ = 3 ∧ y′ = 2
    x:= 1. y:= 2. x:= x+y                  assignment
=   x:= 1. y:= 2. x′ = x+y ∧ y′ = y        substitution law
=   x:= 1. x′ = x+2 ∧ y′ = 2               substitution law
=   x′ = 1+2 ∧ y′ = 2                      arithmetic
=   x′ = 3 ∧ y′ = 2
