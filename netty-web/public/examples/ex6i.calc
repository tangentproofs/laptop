# aPToP Exercise 6(i) — Netty-applicable steps (book uses noncontradiction as ⊥).
# inclusion then noncontradiction (as ⊤) then base.

laws boolean

theorem ex6i: a ∧ ¬a ⇒ b
    a ∧ ¬a ⇒ b                     inclusion
=   ¬(a ∧ ¬a) ∨ b                  noncontradiction
=   ⊤ ∨ b                          base
=   ⊤
