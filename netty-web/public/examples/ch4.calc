# Exercises of aPToP §10.4 (Program Theory), written as calculations.

laws boolean

# ---------------------------------------------------------------------------
# Exercise 121: simplify, in integer variables x and y.

state x, y: int

theorem ex121a: (x:= y+1. y′ > x′) ≡ y′ > x′
    x:= y+1. y′ > x′               substitution law
=   y′ > x′

theorem ex121b: (x:= x+1. y′ > x ∧ x′ > x) ≡ y′ > x+1 ∧ x′ > x+1
    x:= x+1. y′ > x ∧ x′ > x       substitution law
=   y′ > x+1 ∧ x′ > x+1

theorem ex121c: (x:= y+1. y′ = 2×x) ≡ y′ = 2×(y+1)
    x:= y+1. y′ = 2×x              substitution law
=   y′ = 2×(y+1)

theorem ex121d: (x:= 1. x ≥ 1 ⇒ ∃x: int· y′ = 2×x) ≡ ∃x: int· y′ = 2×x
    x:= 1. x ≥ 1 ⇒ ∃x: int· y′ = 2×x      substitution law
=   1 ≥ 1 ⇒ ∃x: int· y′ = 2×x              arithmetic
=   ⊤ ⇒ ∃x: int· y′ = 2×x                  identity
=   ∃x: int· y′ = 2×x

# The quantifier binds y, which the assignment substitutes into the body: the
# bound y is renamed, y″, so as not to be captured.
theorem ex121e: (x:= y. x ≥ 1 ⇒ ∃y: int· y′ = x×y) ≡ y ≥ 1 ⇒ ∃y″: int· y′ = y×y″
    x:= y. x ≥ 1 ⇒ ∃y: int· y′ = x×y       substitution law
=   y ≥ 1 ⇒ ∃y″: int· y′ = y×y″

theorem ex121f: (x:= 1. ok) ≡ x′ = 1 ∧ y′ = y
    x:= 1. ok                      ok
=   x:= 1. x′ = x ∧ y′ = y         substitution law
=   x′ = 1 ∧ y′ = y

theorem ex121g: (x:= 1. y:= 2) ≡ x′ = 1 ∧ y′ = 2
    x:= 1. y:= 2                   assignment
=   x:= 1. x′ = x ∧ y′ = 2         substitution law
=   x′ = 1 ∧ y′ = 2

spec P = y:= 2

theorem ex121h: (x:= 1. P) ≡ x′ = 1 ∧ y′ = 2
    x:= 1. P                       definition of P
=   x:= 1. y:= 2                   ex121g
=   x′ = 1 ∧ y′ = 2

theorem ex121i: (x:= 1. y:= 2. x:= x+y) ≡ x′ = 3 ∧ y′ = 2
    x:= 1. y:= 2. x:= x+y                  assignment
=   x:= 1. y:= 2. x′ = x+y ∧ y′ = y        substitution law
=   x:= 1. x′ = x+2 ∧ y′ = 2               substitution law
=   x′ = 1+2 ∧ y′ = 2                      arithmetic
=   x′ = 3 ∧ y′ = 2

theorem ex121j: (x:= 1. if y > x then x:= x+1 else x:= y fi) ≡ if y > 1 then x′ = 2 ∧ y′ = y else x′ = y ∧ y′ = y fi
    x:= 1. if y > x then x:= x+1 else x:= y fi                        assignment, assignment
=   x:= 1. if y > x then x′ = x+1 ∧ y′ = y else x′ = y ∧ y′ = y fi    substitution law
=   if y > 1 then x′ = 1+1 ∧ y′ = y else x′ = y ∧ y′ = y fi           arithmetic
=   if y > 1 then x′ = 2 ∧ y′ = y else x′ = y ∧ y′ = y fi

theorem ex121k: (x:= 1. x′ > x. x′ = x+1) ≡ x′ > 2
    x:= 1. x′ > x. x′ = x+1                                   sequential composition
=   x:= 1. ∃x″: int· ∃y″: int· x″ > x ∧ x′ = x″+1            substitution law
=   ∃x″: int· ∃y″: int· x″ > 1 ∧ x′ = x″+1                   arithmetic
=   ∃x″: int· ∃y″: int· x″ > 1 ∧ x″ = x′–1                   vacuous quantifier
=   ∃x″: int· x″ > 1 ∧ x″ = x′–1                              one point
=   x′–1 > 1                                                    arithmetic
=   x′ > 2
