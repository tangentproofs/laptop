# Exercise 137 of aPToP §10.4: in integer variables a, b and c, express as
# simply as possible without assignments or sequential compositions.

laws boolean
state a, b, c: int

theorem ex137a: (b:= a–b. b:= a–b) ≡ ok
    b:= a–b. b:= a–b                           assignment
=   b:= a–b. a′ = a ∧ b′ = a–b ∧ c′ = c        substitution law
=   a′ = a ∧ b′ = a–(a–b) ∧ c′ = c             arithmetic
=   a′ = a ∧ b′ = b ∧ c′ = c                   ok
=   ok

theorem ex137b: (a:= a+b. b:= a–b. a:= a–b) ≡ a′ = b ∧ b′ = a ∧ c′ = c
    a:= a+b. b:= a–b. a:= a–b                              assignment
=   a:= a+b. b:= a–b. a′ = a–b ∧ b′ = b ∧ c′ = c           substitution law
=   a:= a+b. a′ = a–(a–b) ∧ b′ = a–b ∧ c′ = c              substitution law
=   a′ = (a+b)–((a+b)–b) ∧ b′ = (a+b)–b ∧ c′ = c           arithmetic
=   a′ = b ∧ b′ = a ∧ c′ = c

theorem ex137d: (a:= a+b. b:= a+b. c:= a+b) ≡ a′ = a+b ∧ b′ = a+2×b ∧ c′ = 2×a+3×b
    a:= a+b. b:= a+b. c:= a+b                              assignment
=   a:= a+b. b:= a+b. a′ = a ∧ b′ = b ∧ c′ = a+b           substitution law
=   a:= a+b. a′ = a ∧ b′ = a+b ∧ c′ = a+(a+b)              substitution law
=   a′ = a+b ∧ b′ = (a+b)+b ∧ c′ = (a+b)+((a+b)+b)         arithmetic
=   a′ = a+b ∧ b′ = a+2×b ∧ c′ = 2×a+3×b

theorem ex137h: (a:= a–b. b:= a–b. a:= a+b) ≡ a′ = 2×a–3×b ∧ b′ = a–2×b ∧ c′ = c
    a:= a–b. b:= a–b. a:= a+b                              assignment
=   a:= a–b. b:= a–b. a′ = a+b ∧ b′ = b ∧ c′ = c           substitution law
=   a:= a–b. a′ = a+(a–b) ∧ b′ = a–b ∧ c′ = c              substitution law
=   a′ = (a–b)+((a–b)–b) ∧ b′ = (a–b)–b ∧ c′ = c           arithmetic
=   a′ = 2×a–3×b ∧ b′ = a–2×b ∧ c′ = c

# The rotation: c, b, a take turns, and then c is restored to a sum.
theorem ex137c: (c:= a–b–c. b:= a–b–c. a:= a–b–c. c:= a+b+c) ≡ a′ = b ∧ b′ = c ∧ c′ = a
    c:= a–b–c. b:= a–b–c. a:= a–b–c. c:= a+b+c                                 assignment
=   c:= a–b–c. b:= a–b–c. a:= a–b–c. a′ = a ∧ b′ = b ∧ c′ = a+b+c              substitution law
=   c:= a–b–c. b:= a–b–c. a′ = a–b–c ∧ b′ = b ∧ c′ = a–b–c+b+c                 substitution law
=   c:= a–b–c. a′ = a–(a–b–c)–c ∧ b′ = a–b–c ∧ c′ = a–(a–b–c)–c+(a–b–c)+c      substitution law
=   a′ = a–(a–b–(a–b–c))–(a–b–c) ∧ b′ = a–b–(a–b–c) ∧ c′ = a–(a–b–(a–b–c))–(a–b–c)+(a–b–(a–b–c))+(a–b–c)    arithmetic
=   a′ = b ∧ b′ = c ∧ c′ = a

# The middle specification says nothing about a′ or c′, so a′ is free, and c′
# follows it.
theorem ex137e: (a:= a+b. b′ = a+b. c:= a+b) ≡ b′ = a+2×b ∧ c′ = a′+b′
    a:= a+b. b′ = a+b. c:= a+b                                                 assignment
=   a:= a+b. b′ = a+b. a′ = a ∧ b′ = b ∧ c′ = a+b                              sequential composition
=   a:= a+b. ∃a″: int· ∃b″: int· ∃c″: int· b″ = a+b ∧ a′ = a″ ∧ b′ = b″ ∧ c′ = a″+b″    one point
=   a:= a+b. ∃b″: int· ∃c″: int· b″ = a+b ∧ b′ = b″ ∧ c′ = a′+b″              one point
=   a:= a+b. ∃c″: int· b′ = a+b ∧ c′ = a′+b′                                   vacuous quantifier
=   a:= a+b. b′ = a+b ∧ c′ = a′+b′                                             substitution law
=   b′ = a+b+b ∧ c′ = a′+b′                                                    arithmetic
=   b′ = a+2×b ∧ c′ = a′+b′

theorem ex137f: (a:= a+b+1. b:= a–b–1. a:= a–b–1) ≡ a′ = b ∧ b′ = a ∧ c′ = c
    a:= a+b+1. b:= a–b–1. a:= a–b–1                                  assignment
=   a:= a+b+1. b:= a–b–1. a′ = a–b–1 ∧ b′ = b ∧ c′ = c               substitution law
=   a:= a+b+1. a′ = a–(a–b–1)–1 ∧ b′ = a–b–1 ∧ c′ = c                substitution law
=   a′ = a+b+1–(a+b+1–b–1)–1 ∧ b′ = a+b+1–b–1 ∧ c′ = c               arithmetic
=   a′ = b ∧ b′ = a ∧ c′ = c

# Neither specification constrains enough: the first leaves the intermediate b
# free, which the second's b′ then absorbs. Every final state is allowed.
theorem ex137g: (a′ = a+b+1. b′ = a–b–1) ≡ ⊤
    a′ = a+b+1. b′ = a–b–1                                           sequential composition
=   ∃a″: int· ∃b″: int· ∃c″: int· a″ = a+b+1 ∧ b′ = a″–b″–1         one point
=   ∃b″: int· ∃c″: int· b′ = a+b+1–b″–1                              vacuous quantifier
=   ∃b″: int· b′ = a+b+1–b″–1                                         arithmetic
=   ∃b″: int· b″ = a+b–b′                                             one point
=   ⊤
